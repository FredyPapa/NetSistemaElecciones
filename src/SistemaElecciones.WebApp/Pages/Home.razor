@page "/"
@page "/home"

<PageTitle>Sistema de Elecciones</PageTitle>

<div id="imagen-de-fondo">
</div>
<div class="row gx-3 mt-2 w-100 justify-content-end">
    <div class="col">
        <div class="card">
            <div class="card card-body align-items-center">
                <img src="assets/images/neutralidad.jpg" alt="Neutralidad" decoding="async" loading="lazy" height="90" width="90" />
                <h4>Neutralidad</h4>
                <p>En las elecciones</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card card-body align-items-center">
                <img src="assets/images/transparencia.jpg" alt="Transparencia" decoding="async" loading="lazy" height="90" width="90" />
                <h4>Transparencia</h4>
                <p>Durante todo el proceso</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card card-body align-items-center">
                <img src="assets/images/responsabilidad.jpg" alt="Responsabilidad" decoding="async" loading="lazy" height="90" width="90" />
                <h4>Responsabilidad</h4>
                <p>Cumpliendo con el deber.</p>
            </div>
        </div>
    </div>
</div>